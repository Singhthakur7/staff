          );
        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(instructionId)
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
      }

      // =======================================================================
      // SUBCOLLECTION 16: /companies/{companyId}/notifications/{notificationId}
      // =======================================================================
      match /notifications/{notificationId} {
        allow get: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(notificationId)
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
        allow list: if isBootstrappedMasterAdmin()
          || (isVerifiedUser() && resource.data.companyAdminEmail == userEmail());
        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), companyId, notificationId)
          && incoming().createdByUid == request.auth.uid
          && hasValidCreateTimestamps(incoming())
          && companyExists(companyId)
          && incoming().companyAdminEmail == companyData(companyId).adminEmail
          && (
            isMasterAdmin()
            || isActiveCompanyAdmin(companyId)
            || isActiveCompanyStaff(companyId)
          );
        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), companyId, notificationId)
          && incoming().companyId == existing().companyId
          && incoming().companyAdminEmail == existing().companyAdminEmail
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(notificationId)
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
      }
    }
  }
}
