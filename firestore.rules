        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(paymentId)
          && isValidPayment(incoming(), companyId, paymentId)
          && incoming().createdByUid == request.auth.uid
          && hasValidCreateTimestamps(incoming())
          && companyExists(companyId)
          && incoming().companyAdminEmail == companyData(companyId).adminEmail
          && incoming().confirmationStatus == 'pending'
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(paymentId)
          && isValidPayment(incoming(), companyId, paymentId)
          && incoming().companyId == existing().companyId
          && incoming().companyAdminEmail == existing().companyAdminEmail
          && incoming().staffId == existing().staffId
          && incoming().staffEmail == existing().staffEmail
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (
            // Tier 1: Master Admin or Company Admin override
            (
              (isMasterAdmin() || isActiveCompanyAdmin(companyId))
              && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'mode', 'category', 'upiIdUsed', 'utr', 'note', 'screenshotUrl', 'confirmationStatus', 'confirmedAt', 'staffNote', 'issueReason', 'updatedAt'])
            )
            // Tier 2A: Staff confirms receipt (terminal state locking: cannot modify once 'confirmed')
            || (
              isActiveCompanyStaff(companyId)
              && existing().staffEmail == userEmail()
              && existing().confirmationStatus != 'confirmed'
              && incoming().confirmationStatus == 'confirmed'
              && incoming().amount == existing().amount
              && incoming().diff(existing()).affectedKeys().hasOnly(['confirmationStatus', 'confirmedAt', 'staffNote', 'issueReason', 'updatedAt'])
            )
            // Tier 2B: Staff reports issue (only when not yet confirmed)
            || (
              isActiveCompanyStaff(companyId)
              && existing().staffEmail == userEmail()
              && existing().confirmationStatus != 'confirmed'
              && incoming().confirmationStatus == 'issue'
              && incoming().amount == existing().amount
              && incoming().diff(existing()).affectedKeys().hasOnly(['confirmationStatus', 'issueReason', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(paymentId)
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
