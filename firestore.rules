      allow create: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompany(incoming(), companyId)
        && incoming().createdByUid == request.auth.uid
        && hasValidCreateTimestamps(incoming())
        && isMasterAdmin();
      allow update: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompany(incoming(), companyId)
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && hasValidUpdateTimestamps(incoming())
        && (
          (
            isMasterAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'tagline', 'address', 'phone', 'upi', 'badge', 'adminEmail', 'active', 'updatedAt'])
          )
          || (
            isActiveCompanyAdmin(companyId)
            && incoming().adminEmail == existing().adminEmail
            && incoming().active == existing().active
            && incoming().slug == existing().slug
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tagline', 'address', 'phone', 'upi', 'badge', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(companyId) && isMasterAdmin();

      // =======================================================================
      // SUBCOLLECTION 5: /companies/{companyId}/members/{memberKey}
      // =======================================================================
      match /members/{memberKey} {
        allow get: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(memberKey)
          && (
            isMasterAdmin()
            || isActiveCompanyAdmin(companyId)
            || (memberKey == emailKey() && existing().email == userEmail())
          );
        allow list: if isBootstrappedMasterAdmin()
          || (isVerifiedUser() && resource.data.email == userEmail());
        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(memberKey)
          && isValidCompanyMember(incoming(), companyId, memberKey)
          && incoming().createdByUid == request.auth.uid
          && hasValidCreateTimestamps(incoming())
          && companyExistsAfter(companyId)
          && (
            isMasterAdmin()
            || (incoming().role == 'staff' && isActiveCompanyAdmin(companyId))
          );
        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(memberKey)
          && isValidCompanyMember(incoming(), companyId, memberKey)
          && incoming().companyId == existing().companyId
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (
            (
              isMasterAdmin()
              && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'staffId', 'active', 'updatedAt'])
            )
            || (
              isActiveCompanyAdmin(companyId)
              && existing().role == 'staff'
              && incoming().role == 'staff'
              && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'staffId', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(memberKey)
          && (
            isMasterAdmin()
            || (existing().role == 'staff' && isActiveCompanyAdmin(companyId))
          );
      }

      // =======================================================================
