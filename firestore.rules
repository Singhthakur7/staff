rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function optString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function optNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    function optBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function isValidSuperAdminConfig(data) {
      return data.keys().hasAll(['email', 'password', 'updatedAt'])
        && data.keys().hasOnly(['email', 'password', 'updatedAt'])
        && isNonEmptyString(data.email, 160)
        && isNonEmptyString(data.password, 160)
        && isNonEmptyString(data.updatedAt, 64);
    }

    function isValidCompany(data, companyId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'adminEmail', 'adminPassword', 'planStatus', 'active', 'createdAt'])
        && data.id == companyId
        && isValidId(data.id)
        && isNonEmptyString(data.name, 160)
        && isNonEmptyString(data.slug, 100)
        && optString(data, 'place', 200)
        && optString(data, 'phone', 40)
        && isNonEmptyString(data.adminEmail, 160)
        && isNonEmptyString(data.adminPassword, 160)
        && (data.planStatus == 'trial' || data.planStatus == 'annual')
        && optNumber(data, 'planYears')
        && optNumber(data, 'planRatePerYear')
        && optString(data, 'planStartDate', 32)
        && optString(data, 'planEndDate', 32)
        && data.active is bool
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidStaff(data, docId) {
      return data.keys().hasAll(['id', 'name', 'role', 'dutyWage', 'email', 'password', 'active', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isNonEmptyString(data.name, 160)
        && isNonEmptyString(data.role, 120)
        && data.dutyWage is number && data.dutyWage >= 0 && data.dutyWage <= 10000000
        && optString(data, 'phone', 40)
        && isNonEmptyString(data.email, 160)
        && isNonEmptyString(data.password, 160)
        && optString(data, 'upiId', 160)
        && optString(data, 'periodFrom', 32)
        && optString(data, 'periodTo', 32)
        && data.active is bool
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidAdvance(data, docId) {
      return data.keys().hasAll(['id', 'staffId', 'staffName', 'amount', 'date', 'mode', 'kind', 'confirmationStatus', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isValidId(data.staffId)
        && isNonEmptyString(data.staffName, 160)
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000
        && isNonEmptyString(data.date, 32)
        && (data.mode == 'gpay' || data.mode == 'upi' || data.mode == 'bank' || data.mode == 'cash')
        && (data.kind == 'advance' || data.kind == 'settlement')
        && (data.confirmationStatus == 'pending' || data.confirmationStatus == 'confirmed' || data.confirmationStatus == 'issue')
        && optString(data, 'screenshotUrl', 500000)
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidCustomer(data, docId) {
      return data.keys().hasAll(['id', 'name', 'workRate', 'received', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isNonEmptyString(data.name, 160)
        && data.workRate is number && data.workRate >= 0
        && optNumber(data, 'expense')
        && data.received is number && data.received >= 0
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidWork(data, docId) {
      return data.keys().hasAll(['id', 'eventTitle', 'date', 'venue', 'status', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isNonEmptyString(data.eventTitle, 240)
        && isNonEmptyString(data.date, 32)
        && isNonEmptyString(data.venue, 240)
        && (data.status == 'scheduled' || data.status == 'in_progress' || data.status == 'completed')
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidSubcontract(data, docId) {
      return data.keys().hasAll(['id', 'vendorName', 'workTitle', 'date', 'totalRate', 'paidAmount', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isNonEmptyString(data.vendorName, 160)
        && isNonEmptyString(data.workTitle, 240)
        && isNonEmptyString(data.date, 32)
        && data.totalRate is number && data.totalRate >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidPunchLog(data, docId) {
      return data.keys().hasAll(['id', 'staffId', 'staffName', 'type', 'date', 'punchInTime', 'status', 'dutyWage', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isValidId(data.staffId)
        && isNonEmptyString(data.staffName, 160)
        && (data.type == 'login_selfie' || data.type == 'duty_punch')
        && isNonEmptyString(data.date, 32)
        && isNonEmptyString(data.punchInTime, 64)
        && (data.status == 'active' || data.status == 'completed')
        && data.dutyWage is number && data.dutyWage >= 0
        && optString(data, 'selfieUrl', 500000)
        && optString(data, 'departSelfieUrl', 500000)
        && optString(data, 'arriveSelfieUrl', 500000)
        && optString(data, 'punchOutSelfieUrl', 500000)
        && optBool(data, 'workCompleted')
        && optString(data, 'workCompletionNote', 1000)
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidExpense(data, docId) {
      return data.keys().hasAll(['id', 'staffId', 'staffName', 'description', 'amount', 'date', 'status', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isValidId(data.staffId)
        && isNonEmptyString(data.staffName, 160)
        && isNonEmptyString(data.description, 500)
        && data.amount is number && data.amount >= 0
        && isNonEmptyString(data.date, 32)
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && optString(data, 'billPhotoUrl', 500000)
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidInstruction(data, docId) {
      return data.keys().hasAll(['id', 'staffId', 'staffName', 'message', 'acknowledged', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && isValidId(data.staffId)
        && isNonEmptyString(data.staffName, 160)
        && isNonEmptyString(data.message, 1000)
        && data.acknowledged is bool
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidNotification(data, docId) {
      return data.keys().hasAll(['id', 'targetRole', 'title', 'message', 'read', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && (data.targetRole == 'company_admin' || data.targetRole == 'staff')
        && isNonEmptyString(data.title, 240)
        && isNonEmptyString(data.message, 1200)
        && data.read is bool
        && isNonEmptyString(data.createdAt, 64);
    }

    function isValidLedger(data, docId) {
      return data.keys().hasAll(['id', 'type', 'title', 'category', 'amount', 'date', 'createdAt'])
        && data.id == docId
        && isValidId(data.id)
        && (data.type == 'income' || data.type == 'expense')
        && isNonEmptyString(data.title, 240)
        && isNonEmptyString(data.category, 160)
        && data.amount is number && data.amount >= 0
        && isNonEmptyString(data.date, 32)
        && isNonEmptyString(data.createdAt, 64);
    }

    // Silent connection health probe document
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow write: if false;
    }

    // Platform super admin configuration
    match /staff_online_config/{configId} {
      allow get: if configId == 'super_admin';
      allow create, update: if configId == 'super_admin' && isValidSuperAdminConfig(incoming());
      allow delete: if false;
    }

    // Registered tenant companies and their isolated subcollections
    match /staff_online_companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if request.query.limit <= 500;
      allow create, update: if isValidId(companyId) && isValidCompany(incoming(), companyId);
      allow delete: if isValidId(companyId);

      match /staff/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidStaff(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /advances/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidAdvance(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /customers/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidCustomer(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /works/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidWork(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /subcontracts/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidSubcontract(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /punchLogs/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 2000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidPunchLog(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /expenses/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidExpense(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /instructions/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidInstruction(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /notifications/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidNotification(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }

      match /ledger/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId);
        allow list: if isValidId(companyId) && request.query.limit <= 1000;
        allow create, update: if isValidId(companyId) && isValidId(docId) && isValidLedger(incoming(), docId);
        allow delete: if isValidId(companyId) && isValidId(docId);
      }
    }
  }
}
