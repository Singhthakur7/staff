        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(customerId)
          && isValidCustomer(incoming(), companyId, customerId)
          && incoming().companyId == existing().companyId
          && incoming().companyAdminEmail == existing().companyAdminEmail
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId))
