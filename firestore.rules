          && incoming().staffId == existing().staffId
          && incoming().staffEmail == existing().staffEmail
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (
            // Tier 1: Master Admin or Company Admin
            (
              (isMasterAdmin() || isActiveCompanyAdmin(companyId))
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'punchOutTime', 'rateMode', 'wageEarned', 'studioName', 'studioPhone', 'venue', 'fromLocation', 'toLocation', 'workNotes', 'gpsLat', 'gpsLng', 'gpsLabel', 'lastEditedBy', 'lastEditedAt', 'updatedAt'])
            )
            // Tier 2A: Staff Punch-Out own active shift
            || (
              isActiveCompanyStaff(companyId)
              && existing().staffEmail == userEmail()
              && existing().status == 'working'
              && incoming().status == 'completed'
              && incoming().wageEarned == existing().wageEarned
              && incoming().rateMode == existing().rateMode
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'punchOutTime', 'gpsLat', 'gpsLng', 'updatedAt'])
            )
            // Tier 2B: Staff Edit own travel/venue notes (cannot alter wageEarned or rateMode)
            || (
              isActiveCompanyStaff(companyId)
              && existing().staffEmail == userEmail()
              && incoming().wageEarned == existing().wageEarned
              && incoming().rateMode == existing().rateMode
              && incoming().status == existing().status
              && incoming().diff(existing()).affectedKeys().hasOnly(['studioName', 'venue', 'fromLocation', 'toLocation', 'workNotes', 'lastEditedBy', 'lastEditedAt', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(attendanceId)
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
