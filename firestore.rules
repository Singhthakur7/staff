rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PILLAR 0: GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PHASE 3: HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function emailKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string
        && slug.size() >= 2
        && slug.size() <= 80
        && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidEmail(val) {
      return val is string
        && val.size() >= 3
        && val.size() <= 160
        && val.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function optString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function optNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    // List-safe Master Admin check (ZERO get()/exists() calls for Pillar 8 compliance)
    function isBootstrappedMasterAdmin() {
      return isVerifiedUser() && userEmail() == 'shriyanshsingh7581@gmail.com';
    }

    // Full Master Admin check for single-doc get/create/update/delete
    function isMasterAdmin() {
      return isBootstrappedMasterAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // =========================================================================
    // PILLAR 1: MASTER GATE RELATIONAL HELPERS (NEVER USED IN ALLOW LIST)
    // =========================================================================
    function companyExists(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId));
    }

    function companyExistsAfter(companyId) {
      return existsAfter(/databases/$(database)/documents/companies/$(companyId));
    }

    function companyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function companyIsActive(companyId) {
      return companyExists(companyId) && companyData(companyId).active == true;
    }

    function isActiveCompanyAdmin(companyId) {
      return isVerifiedUser()
        && companyIsActive(companyId)
        && companyData(companyId).adminEmail == userEmail();
    }

    function isActiveCompanyMember(companyId) {
      return isVerifiedUser()
        && companyIsActive(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(emailKey()))
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(emailKey())).data.active == true;
    }

    function isActiveCompanyStaff(companyId) {
      return isActiveCompanyMember(companyId)
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(emailKey())).data.role == 'staff';
    }

    function hasValidCreateTimestamps(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function hasValidUpdateTimestamps(data) {
      return data.createdAt == existing().createdAt && data.updatedAt == request.time;
    }

    // =========================================================================
    // PILLAR 2: VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP HELPERS)
    // =========================================================================
    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && isValidEmail(data.email)
        && optString(data, 'displayName', 120)
        && data.role == 'master_admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterConfig(data) {
      return data.keys().hasAll(['brandName', 'supportEmail', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['brandName', 'supportEmail', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 120
        && isValidEmail(data.supportEmail)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompany(data, companyId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'adminEmail', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'tagline', 'address', 'phone', 'upi', 'badge', 'adminEmail', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == companyId
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && isValidSlug(data.slug)
        && optString(data, 'tagline', 200)
        && optString(data, 'address', 300)
        && optString(data, 'phone', 40)
        && optString(data, 'upi', 120)
        && optString(data, 'badge', 10)
        && isValidEmail(data.adminEmail)
        && data.active is bool
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembership(data, membershipId) {
      return data.keys().hasAll(['id', 'companyId', 'companySlug', 'companyName', 'companyActive', 'companyAdminEmail', 'email', 'role', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companySlug', 'companyName', 'companyActive', 'companyAdminEmail', 'email', 'role', 'staffId', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == membershipId
        && isValidId(data.id)
        && isValidId(data.companyId)
        && isValidSlug(data.companySlug)
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && data.companyActive is bool
        && isValidEmail(data.companyAdminEmail)
        && isValidEmail(data.email)
        && (data.role == 'company_admin' || data.role == 'staff')
        && optString(data, 'staffId', 128)
        && data.active is bool
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyMember(data, companyId, memberKey) {
      return data.keys().hasAll(['id', 'companyId', 'email', 'role', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'email', 'role', 'staffId', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == memberKey
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.email)
        && (data.role == 'company_admin' || data.role == 'staff')
        && optString(data, 'staffId', 128)
        && data.active is bool
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaff(data, companyId, staffId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'name', 'role', 'email', 'dailyWage', 'salaryDay', 'active', 'joinedDate', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'name', 'role', 'phone', 'email', 'upiId', 'dailyWage', 'salaryDay', 'emergencyContact', 'kycLast4', 'active', 'joinedDate', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == staffId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 100
        && optString(data, 'phone', 40)
        && isValidEmail(data.email)
        && optString(data, 'upiId', 120)
        && data.dailyWage is number && data.dailyWage >= 0 && data.dailyWage <= 1000000
        && data.salaryDay is number && data.salaryDay >= 1 && data.salaryDay <= 31
        && optString(data, 'emergencyContact', 120)
        && optString(data, 'kycLast4', 8)
        && data.active is bool
        && data.joinedDate is string && data.joinedDate.size() <= 32
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data, companyId, attendanceId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'punchInTime', 'status', 'rateMode', 'wageEarned', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'punchInTime', 'punchOutTime', 'status', 'rateMode', 'wageEarned', 'studioName', 'studioPhone', 'venue', 'fromLocation', 'toLocation', 'workNotes', 'gpsLat', 'gpsLng', 'gpsLabel', 'selfieUrl', 'lastEditedBy', 'lastEditedAt', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == attendanceId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.date is string && data.date.size() <= 32
        && data.punchInTime is string && data.punchInTime.size() <= 64
        && optString(data, 'punchOutTime', 64)
        && (data.status == 'working' || data.status == 'completed')
        && (data.rateMode == 'regular' || data.rateMode == 'half' || data.rateMode == 'own_camera' || data.rateMode == 'live_single_cam')
        && data.wageEarned is number && data.wageEarned >= 0 && data.wageEarned <= 100000
        && optString(data, 'studioName', 160)
        && optString(data, 'studioPhone', 40)
        && optString(data, 'venue', 240)
        && optString(data, 'fromLocation', 160)
        && optString(data, 'toLocation', 160)
        && optString(data, 'workNotes', 1000)
        && optNumber(data, 'gpsLat')
        && optNumber(data, 'gpsLng')
        && optString(data, 'gpsLabel', 200)
        && optString(data, 'selfieUrl', 120000)
        && optString(data, 'lastEditedBy', 120)
        && optString(data, 'lastEditedAt', 64)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWork(data, companyId, workId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'date', 'workType', 'eventTitle', 'venue', 'rateMode', 'hasSubContract', 'billTotal', 'billReceived', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'date', 'callTime', 'workType', 'eventTitle', 'venue', 'studioName', 'studioWhatsApp', 'assignedStaffId', 'assignedStaffEmail', 'assignedStaffName', 'rateMode', 'mapsLink', 'hasSubContract', 'subContractorName', 'subContractorWA', 'subContractTotal', 'subContractPaid', 'billTotal', 'billReceived', 'gpayUtr', 'gpayScreenshot', 'notes', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == workId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && data.date is string && data.date.size() <= 32
        && optString(data, 'callTime', 32)
        && data.workType is string && data.workType.size() >= 1 && data.workType.size() <= 160
        && data.eventTitle is string && data.eventTitle.size() >= 1 && data.eventTitle.size() <= 200
        && data.venue is string && data.venue.size() >= 1 && data.venue.size() <= 240
        && optString(data, 'studioName', 160)
        && optString(data, 'studioWhatsApp', 40)
        && optString(data, 'assignedStaffId', 128)
        && optString(data, 'assignedStaffEmail', 160)
        && optString(data, 'assignedStaffName', 120)
        && (data.rateMode == 'regular' || data.rateMode == 'half' || data.rateMode == 'own_camera' || data.rateMode == 'live_single_cam')
        && optString(data, 'mapsLink', 500)
        && data.hasSubContract is bool
        && optString(data, 'subContractorName', 160)
        && optString(data, 'subContractorWA', 40)
        && optNumber(data, 'subContractTotal')
        && optNumber(data, 'subContractPaid')
        && data.billTotal is number && data.billTotal >= 0
        && data.billReceived is number && data.billReceived >= 0
        && optString(data, 'gpayUtr', 100)
        && optString(data, 'gpayScreenshot', 120000)
        && optString(data, 'notes', 1000)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedger(data, companyId, ledgerId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'type', 'title', 'category', 'amount', 'date', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'type', 'title', 'category', 'amount', 'date', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == ledgerId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && (data.type == 'income' || data.type == 'expense')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 120
        && data.amount is number && data.amount > 0 && data.amount <= 100000000
        && data.date is string && data.date.size() <= 32
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data, companyId, paymentId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'amount', 'mode', 'category', 'confirmationStatus', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'amount', 'mode', 'category', 'upiIdUsed', 'utr', 'note', 'screenshotUrl', 'confirmationStatus', 'confirmedAt', 'staffNote', 'issueReason', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == paymentId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.date is string && data.date.size() <= 32
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && (data.mode == 'gpay' || data.mode == 'upi' || data.mode == 'bank' || data.mode == 'cash')
        && (data.category == 'salary' || data.category == 'advance')
        && optString(data, 'upiIdUsed', 120)
        && optString(data, 'utr', 100)
        && optString(data, 'note', 500)
        && optString(data, 'screenshotUrl', 120000)
        && (data.confirmationStatus == 'pending' || data.confirmationStatus == 'confirmed' || data.confirmationStatus == 'issue')
        && optString(data, 'confirmedAt', 64)
        && optString(data, 'staffNote', 400)
        && optString(data, 'issueReason', 400)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomer(data, companyId, customerId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'allowedStaffEmails', 'name', 'studioName', 'income', 'expense', 'received', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'allowedStaffEmails', 'name', 'studioName', 'whatsapp', 'workLocations', 'workDetails', 'income', 'expense', 'received', 'rulesAndTerms', 'addedByStaffName', 'addedByEmail', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == customerId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && data.allowedStaffEmails is list
        && data.allowedStaffEmails.size() <= 100
        && (data.allowedStaffEmails.size() == 0 || data.allowedStaffEmails[0] is string)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 160
        && optString(data, 'whatsapp', 40)
        && optString(data, 'workLocations', 240)
        && optString(data, 'workDetails', 500)
        && data.income is number && data.income >= 0
        && data.expense is number && data.expense >= 0
        && data.received is number && data.received >= 0
        && optString(data, 'rulesAndTerms', 1000)
        && optString(data, 'addedByStaffName', 120)
        && optString(data, 'addedByEmail', 160)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, companyId, expenseId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'title', 'amount', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'title', 'amount', 'billPhotoUrl', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == expenseId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.date is string && data.date.size() <= 32
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && optString(data, 'billPhotoUrl', 120000)
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeave(data, companyId, leaveId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'leaveType', 'date', 'reason', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'leaveType', 'date', 'reason', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == leaveId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && (data.leaveType == 'Casual' || data.leaveType == 'Sick' || data.leaveType == 'Emergency')
        && data.date is string && data.date.size() <= 32
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReceipt(data, companyId, receiptId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'imageUrl', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'date', 'note', 'imageUrl', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == receiptId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.date is string && data.date.size() <= 32
        && optString(data, 'note', 400)
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 120000
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInstruction(data, companyId, instructionId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'message', 'acknowledged', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'staffId', 'staffEmail', 'staffName', 'message', 'presetTag', 'acknowledged', 'acknowledgedAt', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == instructionId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && isValidId(data.staffId)
        && isValidEmail(data.staffEmail)
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && optString(data, 'presetTag', 80)
        && data.acknowledged is bool
        && optString(data, 'acknowledgedAt', 64)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, companyId, notificationId) {
      return data.keys().hasAll(['id', 'companyId', 'companyAdminEmail', 'type', 'title', 'message', 'timestamp', 'read', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyId', 'companyAdminEmail', 'type', 'title', 'message', 'timestamp', 'read', 'staffId', 'gpsLat', 'gpsLng', 'imageUrl', 'priority', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id == notificationId
        && isValidId(data.id)
        && data.companyId == companyId
        && isValidEmail(data.companyAdminEmail)
        && (data.type == 'login' || data.type == 'punch_in' || data.type == 'punch_out' || data.type == 'attendance_edit' || data.type == 'expense' || data.type == 'leave' || data.type == 'receipt' || data.type == 'customer' || data.type == 'payment_confirmed' || data.type == 'payment_issue' || data.type == 'instruction_ack' || data.type == 'system')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.read is bool
        && optString(data, 'staffId', 128)
        && optNumber(data, 'gpsLat')
        && optNumber(data, 'gpsLng')
        && optString(data, 'imageUrl', 120000)
        && (!('priority' in data) || data.priority == 'normal' || data.priority == 'high')
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTION 1: /admins/{adminId}
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isVerifiedUser()
        && isValidId(adminId)
        && (request.auth.uid == adminId || isMasterAdmin());
      allow list: if isBootstrappedMasterAdmin();
      allow create: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && hasValidCreateTimestamps(incoming())
        && isMasterAdmin();
      allow update: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && hasValidUpdateTimestamps(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && isMasterAdmin();
      allow delete: if isVerifiedUser() && isValidId(adminId) && isBootstrappedMasterAdmin();
    }

    // =========================================================================
    // COLLECTION 2: /system/{configId}
    // =========================================================================
    match /system/{configId} {
      allow get: if isVerifiedUser() && isValidId(configId) && isMasterAdmin();
      allow list: if isBootstrappedMasterAdmin();
      allow create: if isVerifiedUser()
        && isValidId(configId)
        && isValidMasterConfig(incoming())
        && incoming().createdByUid == request.auth.uid
        && hasValidCreateTimestamps(incoming())
        && isMasterAdmin();
      allow update: if isVerifiedUser()
        && isValidId(configId)
        && isValidMasterConfig(incoming())
        && incoming().createdByUid == existing().createdByUid
        && hasValidUpdateTimestamps(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['brandName', 'supportEmail', 'updatedAt'])
        && isMasterAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // COLLECTION 3: /memberships/{membershipId}
    // =========================================================================
    match /memberships/{membershipId} {
      allow get: if isVerifiedUser()
        && isValidId(membershipId)
        && (
          existing().email == userEmail()
          || existing().companyAdminEmail == userEmail()
          || isMasterAdmin()
        );
      allow list: if isBootstrappedMasterAdmin()
        || (isVerifiedUser() && (resource.data.email == userEmail() || resource.data.companyAdminEmail == userEmail()));
      allow create: if isVerifiedUser()
        && isValidId(membershipId)
        && isValidMembership(incoming(), membershipId)
        && incoming().createdByUid == request.auth.uid
        && hasValidCreateTimestamps(incoming())
        && companyExistsAfter(incoming().companyId)
        && (
          isMasterAdmin()
          || (
            incoming().role == 'staff'
            && isActiveCompanyAdmin(incoming().companyId)
            && incoming().companyAdminEmail == userEmail()
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(membershipId)
        && isValidMembership(incoming(), membershipId)
        && incoming().companyId == existing().companyId
        && incoming().createdByUid == existing().createdByUid
        && hasValidUpdateTimestamps(incoming())
        && (
          (
            isMasterAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['companySlug', 'companyName', 'companyActive', 'companyAdminEmail', 'email', 'active', 'updatedAt'])
          )
          || (
            isActiveCompanyAdmin(existing().companyId)
            && existing().role == 'staff'
            && incoming().role == 'staff'
            && incoming().companyAdminEmail == existing().companyAdminEmail
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'active', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(membershipId)
        && (
          isMasterAdmin()
          || (existing().role == 'staff' && isActiveCompanyAdmin(existing().companyId))
        );
    }

    // =========================================================================
    // COLLECTION 4: /companies/{companyId}
    // =========================================================================
    match /companies/{companyId} {
      allow get: if isVerifiedUser()
        && isValidId(companyId)
        && (
          isMasterAdmin()
          || existing().adminEmail == userEmail()
          || isActiveCompanyMember(companyId)
        );
      allow list: if isBootstrappedMasterAdmin()
