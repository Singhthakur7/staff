            || isActiveCompanyAdmin(companyId)
            || (isActiveCompanyStaff(companyId) && existing().email == userEmail())
          );
        allow list: if isBootstrappedMasterAdmin()
          || (isVerifiedUser() && (resource.data.companyAdminEmail == userEmail() || resource.data.email == userEmail()));
        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(staffId)
          && isValidStaff(incoming(), companyId, staffId)
          && incoming().createdByUid == request.auth.uid
          && hasValidCreateTimestamps(incoming())
          && companyExists(companyId)
          && incoming().companyAdminEmail == companyData(companyId).adminEmail
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId));
        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(staffId)
          && isValidStaff(incoming(), companyId, staffId)
          && incoming().companyId == existing().companyId
          && incoming().companyAdminEmail == existing().companyAdminEmail
          && incoming().createdByUid == existing().createdByUid
          && hasValidUpdateTimestamps(incoming())
          && (isMasterAdmin() || isActiveCompanyAdmin(companyId))
