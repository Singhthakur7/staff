{
  "entities": {
    "SuperAdminConfig": {
      "title": "SuperAdminConfig",
      "description": "Platform super administrator login credentials and update timestamp.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "password", "updatedAt"]
    },
    "CompanyRecord": {
      "title": "CompanyRecord",
      "description": "Registered tenant company workspace profile, plan status, and admin credentials.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "place": { "type": "string" },
        "phone": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminPassword": { "type": "string" },
        "planYears": { "type": "number" },
        "planStatus": { "type": "string", "enum": ["trial", "annual"] },
        "planRatePerYear": { "type": "number" },
        "planStartDate": { "type": "string" },
        "planEndDate": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "adminEmail", "adminPassword", "planStatus", "active", "createdAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Company staff member profile, wage, UPI, and login credentials.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "dutyWage": { "type": "number" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "upiId": { "type": "string" },
        "periodFrom": { "type": "string" },
        "periodTo": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "role", "dutyWage", "email", "password", "active", "createdAt"]
    },
    "AdvancePaymentRecord": {
      "title": "AdvancePaymentRecord",
      "description": "Staff salary advance or Google Pay settlement transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "dueDate": { "type": "string" },
        "mode": { "type": "string", "enum": ["gpay", "upi", "bank", "cash"] },
        "kind": { "type": "string", "enum": ["advance", "settlement"] },
        "note": { "type": "string" },
        "utr": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "confirmationStatus": { "type": "string", "enum": ["pending", "confirmed", "issue"] },
        "confirmedAt": { "type": "string" },
        "staffNote": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "staffId", "staffName", "amount", "date", "mode", "kind", "confirmationStatus", "createdAt"]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Client billing, work rate, and received payment record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "companyOrStudio": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "workDetails": { "type": "string" },
        "workRate": { "type": "number" },
        "expense": { "type": "number" },
        "received": { "type": "number" },
        "rulesTerms": { "type": "string" },
        "paymentHistory": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "workRate", "received", "createdAt"]
    },
    "MultiCrewWork": {
      "title": "MultiCrewWork",
      "description": "Scheduled multi-crew event or production work assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventTitle": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "workType": { "type": "string" },
        "crewMembers": { "type": "array" },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "eventTitle", "date", "venue", "status", "createdAt"]
    },
    "SubcontractRecord": {
      "title": "SubcontractRecord",
      "description": "Third-party vendor subcontract assignment and payout tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendorName": { "type": "string" },
        "workTitle": { "type": "string" },
        "date": { "type": "string" },
        "totalRate": { "type": "number" },
        "paidAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vendorName", "workTitle", "date", "totalRate", "paidAmount", "createdAt"]
    },
    "PunchLogRecord": {
      "title": "PunchLogRecord",
      "description": "Staff 3-stage live selfie attendance, route, and GPS punch log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "staffRole": { "type": "string" },
        "type": { "type": "string", "enum": ["login_selfie", "duty_punch"] },
        "workTitle": { "type": "string" },
        "date": { "type": "string" },
        "punchInTime": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "dutyWage": { "type": "number" },
        "selfieUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "staffId", "staffName", "type", "date", "punchInTime", "status", "dutyWage", "createdAt"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Staff submitted field expense with optional bill photo.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "staffId", "staffName", "description", "amount", "date", "status", "createdAt"]
    },
    "LiveInstruction": {
      "title": "LiveInstruction",
      "description": "Real-time dispatch instruction from Company Admin to Staff.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "message": { "type": "string" },
        "acknowledged": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "staffId", "staffName", "message", "acknowledged", "createdAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Company scoped notification entry for admins or staff.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetRole": { "type": "string", "enum": ["company_admin", "staff"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetRole", "title", "message", "read", "createdAt"]
    },
    "ManualLedgerEntry": {
      "title": "ManualLedgerEntry",
      "description": "Manual income or expense ledger entry for P&L reporting.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "category", "amount", "date", "createdAt"]
    }
  },
  "firestore": {
    "/staff_online_config/{configId}": {
      "schema": { "$ref": "#/entities/SuperAdminConfig" },
      "description": "Global platform configuration documents (super_admin credentials)."
    },
    "/staff_online_companies/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyRecord" },
      "description": "Registered tenant companies and their subscription status."
    },
    "/staff_online_companies/{companyId}/staff/{docId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Tenant-isolated staff accounts."
    },
    "/staff_online_companies/{companyId}/advances/{docId}": {
      "schema": { "$ref": "#/entities/AdvancePaymentRecord" },
      "description": "Tenant-isolated salary advances and GPay settlements."
    },
    "/staff_online_companies/{companyId}/customers/{docId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Tenant-isolated customer billing accounts."
    },
    "/staff_online_companies/{companyId}/works/{docId}": {
      "schema": { "$ref": "#/entities/MultiCrewWork" },
      "description": "Tenant-isolated multi-crew event dispatches."
    },
    "/staff_online_companies/{companyId}/subcontracts/{docId}": {
      "schema": { "$ref": "#/entities/SubcontractRecord" },
      "description": "Tenant-isolated vendor subcontract records."
    },
    "/staff_online_companies/{companyId}/punchLogs/{docId}": {
      "schema": { "$ref": "#/entities/PunchLogRecord" },
      "description": "Tenant-isolated live selfie & 3-stage site tracking logs."
    },
    "/staff_online_companies/{companyId}/expenses/{docId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Tenant-isolated staff expense claims."
    },
    "/staff_online_companies/{companyId}/instructions/{docId}": {
      "schema": { "$ref": "#/entities/LiveInstruction" },
      "description": "Tenant-isolated admin-to-staff dispatch instructions."
    },
    "/staff_online_companies/{companyId}/notifications/{docId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Tenant-isolated activity notifications."
    },
    "/staff_online_companies/{companyId}/ledger/{docId}": {
      "schema": { "$ref": "#/entities/ManualLedgerEntry" },
      "description": "Tenant-isolated manual P&L ledger records."
    }
  }
}
