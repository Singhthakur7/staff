      "title": "AdminUser",
      "description": "Authorized Master Admin user document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["master_admin"] },
