  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Master Admin UID registry."
    },
    "/system/{configId}": {
      "schema": { "$ref": "#/entities/MasterConfig" },
      "description": "Global platform configuration (doc: master_config)."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Tenant company directory and branding profiles."
